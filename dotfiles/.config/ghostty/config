term = xterm-256color
macos-icon = retro
window-decoration = none
copy-on-select = clipboard

shell-integration-features = no-cursor
mouse-hide-while-typing = true
cursor-style = block

font-size = 15
font-family = "Mononoki Nerd Font Mono"

theme = Earthsong
background-opacity = 0.8
background-blur-radius = 30
